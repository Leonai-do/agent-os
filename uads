#!/bin/bash
# UADS CLI - Wrapper for UADS compiler

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/.agent-os/uads_compiler.py"

# Check if Python script exists
if [ ! -f "$PYTHON_SCRIPT" ]; then
    echo "Error: UADS compiler not found at $PYTHON_SCRIPT"
    exit 1
fi

# Run the Python compiler
python3 "$PYTHON_SCRIPT" "$@"
